{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=DentalInformationSystem;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "SecretKey": "YourSuperSecretKeyForJWTTokenGenerationMinimum32CharactersLong!",
    "Issuer": "DentalClinicAPI",
    "Audience": "DentalClinicApp",
    "ExpirationHours": 8
  },
  "Email": {
    "Provider": "File",
    "Smtp": {
      "Host": "smtp.gmail.com",
      "Port": "587",
      "EnableSsl": "true",
      "Username": "your-email@gmail.com",
      "Password": "your-app-password",
      "From": "noreply@dentalclinic.com"
    }
  },
  "Uploads": {
    "BasePath": "wwwroot/uploads",
    "MaxFileSizeBytes": 10485760,
    "AllowedExtensions": ".pdf,.jpg,.jpeg,.png,.gif,.bmp,.dcm,.doc,.docx,.xls,.xlsx"
  }
}
